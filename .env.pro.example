# IA Art Studio Pro — exemple
IA_ART_PRO_PORT=3093
IA_ART_PRO_DATA_DIR=./data
IA_ART_PRO_BACKUP_DIR=./backups
IA_ART_PRO_BACKUP_KEEP_DAYS=14

# Connexion n8n facultative au premier démarrage.
# Elle peut ensuite être configurée depuis Administration.
VISUAL_AI_WEBHOOK_URL=
VISUAL_AI_WEBHOOK_SECRET=
VISUAL_AI_AUTH_HEADER=X-IA-Art-Studio-Token
VISUAL_AI_TIMEOUT_SECONDS=300
VISUAL_AI_MAX_FILE_SIZE_MB=50

# URL facultative vers Studio Visuel / ChatGPT.
VISUAL_AI_AGENT_URL=
