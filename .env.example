# Port HTTP exposé sur le poste
VISUAL_AI_PORT=3093

# Dossier hôte monté dans /data.
# Pour reprendre directement une base Visual AI Studio existante, pointez ce chemin
# vers le dossier qui contient visual-ai-studio.db et le dossier projects.
VISUAL_AI_HOST_DATA_DIR=./data

# La configuration n8n se fait ensuite depuis Administration dans l'application.
# Ces variables restent disponibles comme configuration de démarrage facultative.
# Le webhook d'import Notion est un POST multipart.
# Exemple si n8n tourne dans la VM Freebox :
# http://IP-DE-LA-VM:5678/webhook/ia-art-import-notion-hub
# Ne pas utiliser /webhook-test ni 127.0.0.1 depuis le conteneur.
VISUAL_AI_WEBHOOK_URL=
VISUAL_AI_WEBHOOK_SECRET=
VISUAL_AI_AUTH_HEADER=X-Visual-AI-Token
VISUAL_AI_TIMEOUT_SECONDS=300
VISUAL_AI_MAX_FILE_SIZE_MB=50

# URL optionnelle du GPT/agent Studio Visuel.
VISUAL_AI_AGENT_URL=
